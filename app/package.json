{
  "name": "ssl96-adb-control",
  "version": "1.0.2",
  "description": "SSL96 ADB LED Diagnostic & Control",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch server.js --watch main.js --watch public --ext js,html,css --exec \"electron .\"",
    "prebuild": "npm version patch --no-git-tag-version",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.ssl96.adbcontrol",
    "productName": "SSL96 ADB Control",
    "publish": [
      {
        "provider": "github",
        "owner": "Meliodax17",
        "repo": "ssl96-adb-control"
      }
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.21.0",
    "node-hid": "^3.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.7"
  }
}
